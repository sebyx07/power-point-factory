# PowerPoint Factory — copy to .env (gitignored). Bun loads it automatically.
# Every variable read in src/env.ts must appear here (guard: scripts/lint/env-in-example.ts).

# ── Kubeez · AI images for slides ────────────────────────────────────────────
# Key: https://kubeez.com/settings/api-keys  (sk_live_…, scopes generate:media + read:generations)
# Unset → slides get labeled placeholders and QA warns (builds still work offline).
KUBEEZ_API_KEY=
# REST base. Spec: https://api.kubeez.com/openapi.json
KUBEEZ_API_URL=https://api.kubeez.com
# Default image model when a slide doesn't pin one. bun scripts/kubeez/models.ts lists them.
# nano-banana-2 = best default · nano-banana-pro = top quality · z-image = cheapest/fastest
KUBEEZ_IMAGE_MODEL=nano-banana-2
# Default video model (text-to-video). seedance-2-fast = good/cheap · kling-3-0-pro / veo3-1 = best
KUBEEZ_VIDEO_MODEL=seedance-2-fast
# Default music model (instrumental beds for keynote openers)
KUBEEZ_MUSIC_MODEL=V6
# Polling cadence and give-up time for async generations (ms)
KUBEEZ_POLL_INTERVAL_MS=4000
KUBEEZ_TIMEOUT_MS=240000

# ── Build behaviour ─────────────────────────────────────────────────────────
# placeholder | error — when a slide needs a generated image but no key is set
DECK_MISSING_IMAGE=placeholder

# ── QA renderer ─────────────────────────────────────────────────────────────
# PNG resolution of slide screenshots (110 → 1467×825)
QA_RENDER_DPI=110
# LibreOffice binary (headless render .pptx → PDF → PNG)
SOFFICE_BIN=soffice
